#!/usr/bin/env bash
# Runs the leak scanner before every commit. Turn it on once per clone:
#   git config core.hooksPath .githooks
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
export LEAK_SCAN_ALLOWED_EMAILS="${LEAK_SCAN_ALLOWED_EMAILS:-hello@looot\.ai}"
exec bash "$root/scripts/leak-scan.sh" "$root"
